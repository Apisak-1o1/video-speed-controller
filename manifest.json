{
  "manifest_version": 3,
  "name": "Video Speed Controller",
  "version": "1.2.0",
  "description": "ปรับความเร็ววิดีโอและจำความเร็วแยกตามเว็บไซต์",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Video Speed Controller",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}